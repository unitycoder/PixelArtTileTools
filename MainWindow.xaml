<Window x:Class="PixelArtTileTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PixelArtTileTools"
        mc:Ignorable="d"
        Title="PixelArtTileTools" Width="1280" Height="720"  WindowStartupLocation="CenterScreen"  Background="{DynamicResource ThemeDarkestBackground}" MinWidth="640" MinHeight="480" AllowsTransparency="True" WindowStyle="None" KeyDown="OnWindowKeyDown" Closing="Window_Closing" SizeChanged="Window_SizeChanged" Icon="Images/icon.ico" SourceInitialized="Window_SourceInitialized" MouseDown="Window_MouseDown">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Colors.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="2,0,2,0">
        <Grid.RowDefinitions>
            <!-- menubar -->
            <RowDefinition Height="23" />
            <!-- content -->
            <RowDefinition Height="*" />
            <!-- statusbar -->
            <RowDefinition Height="25" />
        </Grid.RowDefinitions>
        
        <!-- menubar -->
        <Grid Grid.Row="0" UseLayoutRounding="False">
            <Button  PreviewMouseDoubleClick="Button_PreviewMouseDoubleClick">
                <Button.Template>
                    <ControlTemplate>
                        <Rectangle Fill="{DynamicResource ThemeDarkMenuBar}" MouseDown="OnRectangleMouseDown"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Image Source="Images/icon.png" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Left" Width="16" Height="16" Margin="4,0,0,0" SnapsToDevicePixels="True" UseLayoutRounding="True" />
            <Label Content="PixelArtTileTools" IsHitTestVisible="False" Margin="19,0,0,-5"  Foreground="{DynamicResource ThemeMainTitle}" FontSize="12" HorizontalAlignment="Left"  />
            <!-- minimize -->
            <Button x:Name="btnMinimize" BorderThickness="0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="23" Width="23" Background="Transparent" Click="BtnMinimize_Click" Margin="0,0,27,0" Padding="2,0,2,8" IsTabStop="False">
                <TextBlock Text="–" FontSize="15" Foreground="{DynamicResource ThemeWindowMinClose}" Padding="0" Height="23" HorizontalAlignment="Center"/>
            </Button>
            <!-- close -->
            <Button x:Name="btnClose" BorderThickness="0" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" HorizontalAlignment="Right" VerticalAlignment="Top" Height="23" Width="23" Background="Transparent" Click="BtnClose_Click" Padding="0,2" IsTabStop="False">
                <TextBlock Text="❌" FontSize="10" Foreground="{DynamicResource ThemeWindowMinClose}" Padding="5,3,4,4" HorizontalAlignment="Center" />
            </Button>
        </Grid>

        <!-- content -->
        <Grid Grid.Row="1" Margin="1,1,1,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- palette panel -->
            <Border Grid.Column="0" Background="{DynamicResource ThemeDarkMenuBar}" UseLayoutRounding="False">
                <StackPanel Margin="1,1,1,1">
                    <Border BorderBrush="Black" BorderThickness="1" VerticalAlignment="Top" Background="Black">
                        <Image x:Name="paletteImage" Height="476" VerticalAlignment="Top" Stretch="Fill" MouseLeftButtonDown="PaletteLeftButtonDown" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                    </Border>
                </StackPanel>
            </Border>


        </Grid>

        <!-- statusbar -->
        <Border Grid.Row="2" Background="{DynamicResource ThemeDarkMenuBar}" UseLayoutRounding="False">
            <StatusBar>
                <StatusBarItem>
                    <TextBlock x:Name="statusBarText" Text="StatusBar" FontSize="10" />
                </StatusBarItem>
            </StatusBar>
        </Border>

    </Grid>
</Window>
